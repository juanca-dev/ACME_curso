@* @model Models.ACME.RequisicionEntidad

@{
    ViewData["Title"] = "BuscarxID";
}

<style>
    .btn img {
        width: 24px;
        height: auto; /* Esto mantiene la proporción de la imagen */
    }
</style>

<div class="card">
    <div class="card-header">
        <div class="d-flex align-items-center justify-content-between">
            <h5 class="col col-md-4">Requisición - Ver detalle</h5>
            <nav class="navbar">
                <div class="container justify-content-end">
                    <div class="btn-group" role="group" aria-label="Barra de herramientas">
                        <!-- Botón: Ir al primer registro -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Inicio" title="Ir al primer registro">
                            <i class="bi bi-skip-backward-fill"></i>
                        </a>

                        <!-- Botón: Ir al registro anterior -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Anterior" title="Ir al registro anterior">
                            <i class="bi bi-caret-left-fill"></i>
                        </a>

                        <!-- Botón: Ir al siguiente registro -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Siguiente" title="Ir al siguiente registro">
                            <i class="bi bi-caret-right-fill"></i>
                        </a>

                        <!-- Botón: Ir al último registro -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Fin" title="Ir al último registro">
                            <i class="bi bi-skip-forward-fill"></i>
                        </a>

                        <!-- Botón: Anular -->
                        <a class="btn btn-danger" asp-action="Anular" asp-route-IDRequisicion="@Model.IDRequisicion" title="Anular registro">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <div class="card-body">
        <div>
            <!-- Campos del formulario -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="IDRequisicion" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.IDRequisicion)</label>
                    <input type="number" min="0" class="form-control" asp-for="IDRequisicion" disabled />
                    <span asp-validation-for="IDRequisicion" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IDEmpresa" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.IDEmpresa)</label>
                    @Html.DropDownList("IDEmpresa", ViewBag.ListaEmpresaEntidad0 as SelectList, "Seleccione un tipo", new { @class = "form-select form-select-md mb-3", @disabled = "disabled" })
                    <span asp-validation-for="IDEmpresa" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NroRequisicion" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.NroRequisicion)</label>
                    <input type="text" class="form-control" asp-for="NroRequisicion" disabled />
                    <span asp-validation-for="NroRequisicion" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">

                <div class="col-md-4">
                    <label asp-for="FechaEmision" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.FechaEmision)</label>
                    <input type="date" class="form-control" asp-for="FechaEmision" disabled />
                    <span asp-validation-for="FechaEmision" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="col-sm-4 col-form-label" asp-for="Aprobada">@Html.DisplayNameFor(model => Model.Aprobada)</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Aprobada" disabled>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="col-sm-4 col-form-label" asp-for="Activo">@Html.DisplayNameFor(model => Model.Activo)</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Activo" disabled>
                    </div>
                </div>
            </div>

            <!-- Pestañas -->
            <ul class="nav nav-tabs mt-4" id="tabDetails" role="tablist">

                <li class="nav-item">
                    <a class="nav-link active" id="RequisicionDetalle-tab" data-bs-toggle="tab" href="#RequisicionDetalle" role="tab">RequisicionDetalle</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link " id="RequisicionAnotacion-tab" data-bs-toggle="tab" href="#RequisicionAnotacion" role="tab">RequisicionAnotacion</a>
                </li>
            </ul>

            <!-- Contenido de las pestañas -->
            <div class="tab-content mt-3" id="tabDetailsContent">

                <!-- Tab: RequisicionDetalle -->
                <div class="tab-pane fade show active" id="RequisicionDetalle" role="tabpanel">
                    <div class="d-flex justify-content-between mb-2">
                        <h4>RequisicionDetalle</h4>
                    </div>
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => Model.ListaRequisicionDetalle[0].Linea)</th>
                                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => Model.ListaRequisicionDetalle[0].IDArticulo)</th>
                                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => Model.ListaRequisicionDetalle[0].Articulo)</th>
                                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => Model.ListaRequisicionDetalle[0].Cantidad)</th>
                                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => Model.ListaRequisicionDetalle[0].Activo)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var RequisicionDetalleEntidad in Model.ListaRequisicionDetalle)
                            {
                                <tr>
                                    <th scope="row" style="text-align: center;">@RequisicionDetalleEntidad.Linea</th>
                                    <td>@RequisicionDetalleEntidad.IDArticulo</td>
                                    <td>@RequisicionDetalleEntidad.Articulo</td>
                                    <td>@RequisicionDetalleEntidad.Cantidad</td>
                                    @{
                                        string activoActivo = string.Empty;
                                        if (RequisicionDetalleEntidad?.Activo == true)
                                        {
                                            activoActivo = "checked";
                                        }
                                        else
                                        {
                                            activoActivo = string.Empty;
                                        }
                                    }
                                    <td class="text-center align-middle"><input class="form-check-input" type="checkbox" disabled @activoActivo></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Tab: RequisicionAnotacion -->
                <div class="tab-pane fade " id="RequisicionAnotacion" role="tabpanel">
                    <div class="d-flex justify-content-between mb-2">
                        <h4>RequisicionAnotacion</h4>
                    </div>
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => Model.ListaRequisicionAnotacion[0].Anotacion)</th>
                                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => Model.ListaRequisicionAnotacion[0].Activo)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var RequisicionAnotacionEntidad in Model.ListaRequisicionAnotacion)
                            {
                                <tr>
                                    <td>@RequisicionAnotacionEntidad.Anotacion</td>
                                    @{
                                        string activoActivo = string.Empty;
                                        if (RequisicionAnotacionEntidad?.Activo == true)
                                        {
                                            activoActivo = "checked";
                                        }
                                        else
                                        {
                                            activoActivo = string.Empty;
                                        }
                                    }
                                    <td class="text-center align-middle"><input class="form-check-input" type="checkbox" disabled @activoActivo></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row">
                <div class="col-4">
                    <a asp-action="IndexPaginado" class="btn btn-secondary">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>

 *@
@model Models.ACME.RequisicionEntidad

@{
    ViewData["Title"] = "Detalle de requisición";
}

@* ── Encabezado con navegación de registros ── *@
<div class="mod-header">
    <div>
        <h1 class="mod-title">Requisiciones</h1>
        <p class="mod-sub">Ver detalle · @Model.NroRequisicion</p>
    </div>
    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">

        @* ── Navegación entre registros ── *@
        <div style="display:flex;gap:.35rem">
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Inicio"
               title="Primer registro">
                <i class="bi bi-skip-backward-fill" style="font-size:.75rem"></i>
            </a>
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Anterior"
               title="Registro anterior">
                <i class="bi bi-caret-left-fill" style="font-size:.75rem"></i>
            </a>
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Siguiente"
               title="Registro siguiente">
                <i class="bi bi-caret-right-fill" style="font-size:.75rem"></i>
            </a>
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDRequisicion="@ViewBag.Fin"
               title="Último registro">
                <i class="bi bi-skip-forward-fill" style="font-size:.75rem"></i>
            </a>
        </div>

        @* ── Divisor ── *@
        <div style="width:1px;height:28px;background:#e5e7eb"></div>

        @* ── Acción anular ── *@
        <a class="btn-tbl btn-tbl-del" style="width:32px;height:32px"
           asp-action="Anular" asp-route-IDRequisicion="@Model.IDRequisicion"
           title="Anular">
            <i class="bi bi-trash"></i>
        </a>

        @* ── Volver ── *@
        <a asp-action="IndexPaginado" class="form-back" style="margin-bottom:0">
            ← Volver
        </a>
    </div>
</div>

@* ── Card datos principales ── *@
<div class="form-card" style="max-width:100%;margin-bottom:1.25rem">

    @* ── Sección: Identificación ── *@
    <div class="form-section">Identificación</div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Código requisición</label>
            <div class="form-input" style="background:#f9fafb;color:#9ca3af;cursor:default">
                @Model.IDRequisicion
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Nro. requisición</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-family:monospace;font-weight:600">
                @Model.NroRequisicion
            </div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Empresa</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-weight:600">
                @Model.Empresa
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">RUC</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-family:monospace">
                @Model.RUC
            </div>
        </div>
    </div>

    @* ── Sección: Estado ── *@
    <div class="form-section">Estado</div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Fecha de emisión</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default">
                @Model.FechaEmision.ToString("dd/MM/yyyy")
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Aprobación</label>
            <div style="padding-top:.4rem">
                @if (Model.Aprobada)
                {
                    <span class="badge badge-green">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#059669" /></svg>
                        Aprobada
                    </span>
                }
                else
                {
                    <span class="badge badge-yellow">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#d97706" /></svg>
                        Pendiente
                    </span>
                }
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Vigencia</label>
            <div style="padding-top:.4rem">
                @if (Model.Activo)
                {
                    <span class="badge badge-blue">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#2563eb" /></svg>
                        Vigente
                    </span>
                }
                else
                {
                    <span class="badge badge-gray">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#9ca3af" /></svg>
                        Anulada
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@* ── Pestañas de detalle ── *@
<style>
    .tab-nav {
        display: flex;
        gap: 0;
        border-bottom: 1.5px solid #e5e7eb;
        margin-bottom: 0;
    }

    .tab-btn {
        padding: .6rem 1.25rem;
        font-size: .82rem;
        font-weight: 600;
        color: #6b7280;
        background: transparent;
        border: none;
        border-bottom: 2.5px solid transparent;
        cursor: pointer;
        transition: all .15s;
        margin-bottom: -1.5px;
    }

        .tab-btn:hover {
            color: #374151;
        }

        .tab-btn.active {
            color: #1a1a2e;
            border-bottom-color: #1a1a2e;
        }

    .tab-pane {
        display: none;
    }

        .tab-pane.active {
            display: block;
        }
</style>

<div class="tbl-card">
    <div style="padding:.85rem 1rem .5rem">
        <div class="tab-nav">
            <button class="tab-btn active" onclick="switchTab(event,'tab-detalle')">
                <i class="bi bi-list-ul"></i> Detalle de artículos
                <span style="background:#e5e7eb;color:#374151;font-size:.7rem;padding:.1rem .45rem;border-radius:999px;margin-left:.4rem">
                    @Model.ListaRequisicionDetalle?.Count
                </span>
            </button>
            <button class="tab-btn" onclick="switchTab(event,'tab-anotacion')">
                <i class="bi bi-chat-left-text"></i> Anotaciones
                <span style="background:#e5e7eb;color:#374151;font-size:.7rem;padding:.1rem .45rem;border-radius:999px;margin-left:.4rem">
                    @Model.ListaRequisicionAnotacion?.Count
                </span>
            </button>
        </div>
    </div>

    @* ── Tab: Detalle de artículos ── *@
    <div id="tab-detalle" class="tab-pane active">
        @if (Model.ListaRequisicionDetalle != null && Model.ListaRequisicionDetalle.Any())
        {
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Línea</th>
                        <th>#Artículo</th>
                        <th>Artículo</th>
                        <th style="text-align:right">Cantidad</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.ListaRequisicionDetalle)
                    {
                        <tr>
                            <td style="color:#9ca3af;font-size:.8rem;font-weight:600">@d.Linea</td>
                            <td style="font-family:monospace;font-size:.82rem;color:#6b7280">@d.IDArticulo</td>
                            <td style="font-weight:600">@d.Articulo</td>
                            <td style="text-align:right;font-family:monospace;font-weight:600">@d.Cantidad</td>
                            <td>
                                @if (d.Activo == true)
                                {
                                    <span class="badge badge-green">
                                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#059669" /></svg>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-red">
                                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#dc2626" /></svg>
                                        Inactivo
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                Sin artículos en esta requisición
            </div>
        }
    </div>

    @* ── Tab: Anotaciones ── *@
    <div id="tab-anotacion" class="tab-pane">
        @if (Model.ListaRequisicionAnotacion != null && Model.ListaRequisicionAnotacion.Any())
        {
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Anotación</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.ListaRequisicionAnotacion)
                    {
                        <tr>
                            <td>@a.Anotacion</td>
                            <td>
                                @if (a.Activo == true)
                                {
                                    <span class="badge badge-green">
                                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#059669" /></svg>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-red">
                                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#dc2626" /></svg>
                                        Inactivo
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-chat-left"></i>
                Sin anotaciones en esta requisición
            </div>
        }
    </div>
</div>

@* ── Script de pestañas (sin Bootstrap JS) ── *@
<script>
    function switchTab(e, tabId) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        e.currentTarget.classList.add('active');
        document.getElementById(tabId).classList.add('active');
    }
</script>
