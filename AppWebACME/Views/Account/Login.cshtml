@model Models.ACME.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ACME Sistema</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />   <!-- ← sin Razor, sin @@ -->
</head>
<body>

    <div class="login-wrap">
        <div class="login-card">

            <div class="brand">
                <div class="brand-icon">🏢</div>
                <div>
                    <div class="brand-name">XperTek</div>
                    <div class="brand-sub">ACME Sistema</div>
                </div>
            </div>

            <h1 class="login-title">Bienvenido de nuevo</h1>
            <p class="login-sub">Ingresa tus credenciales para continuar</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
            {
                foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div class="alert-error" role="alert">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                        </svg>
                        <span>@error.ErrorMessage</span>
                    </div>
                }
            }

            <form asp-action="Login" asp-controller="Account" method="post" id="frmLogin">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="field-wrap">
                    <label asp-for="NombreUsuario" class="field-label"></label>
                    <div class="field-inner">
                        <span class="field-icon">
                            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </span>
                        <input asp-for="NombreUsuario"
                               class="form-control-dark @(ViewData.ModelState["NombreUsuario"]?.Errors.Any() == true ? "input-error" : "")"
                               placeholder="usuario o correo@acme.com"
                               autocomplete="username"
                               spellcheck="false" />
                    </div>
                    <span asp-validation-for="NombreUsuario" class="field-error"></span>
                </div>

                <div class="field-wrap">
                    <label asp-for="Password" class="field-label"></label>
                    <div class="field-inner">
                        <span class="field-icon">
                            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </span>
                        <input asp-for="Password"
                               id="inputPass"
                               type="password"
                               class="form-control-dark @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "input-error" : "")"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                        <button type="button" class="toggle-pass" onclick="togglePass()" title="Mostrar / ocultar">
                            <svg id="iconEye" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="remember-row">
                    <input asp-for="Recordarme" type="checkbox" class="check-custom" id="chkRecordarme" />
                    <label for="chkRecordarme">Mantener sesión activa</label>
                </div>

                <button type="submit" class="btn-login" id="btnLogin">
                    <span class="btn-text">Ingresar al sistema</span>
                    <span class="spinner" id="spinner"></span>
                </button>
            </form>

            <div class="login-footer">
                Sistema ACME &nbsp;·&nbsp; v2.0 &nbsp;·&nbsp;
                <span style="color:#475569">© @DateTime.Now.Year XperTek</span>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePass() {
            const input = document.getElementById('inputPass');
            const icon  = document.getElementById('iconEye');
            const show  = input.type === 'password';
            input.type  = show ? 'text' : 'password';
            icon.style.opacity = show ? '.5' : '1';
        }

        document.getElementById('frmLogin').addEventListener('submit', function () {
            if (!this.checkValidity()) return;
            document.getElementById('btnLogin').disabled = true;
            document.querySelector('.btn-text').textContent = 'Verificando...';
            document.getElementById('spinner').style.display = 'inline-block';
        });
    </script>
</body>
</html>