@model Models.ACME.TipoEmpresaEntidad

@{
    ViewData["Title"] = "Crear tipo de empresa";
}

@* ?? Encabezado de módulo ?? *@
<div class="mod-header">
    <div>
        <h1 class="mod-title">Tipo de empresa</h1>
        <p class="mod-sub">Crear nuevo registro</p>
    </div>
    <a asp-action="IndexPaginado" class="form-back" style="margin-bottom:0">
        ? Volver al listado
    </a>
</div>

@* ?? Formulario ?? *@
<div class="form-card" style="max-width:640px">
    <form asp-action="Crear" method="post">

        <div class="form-section">Identificación</div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="IDTipoEmpresa">Código</label>
                <input type="number" min="0" class="form-input" asp-for="IDTipoEmpresa" readonly
                       style="background:#f9fafb;color:#9ca3af;cursor:not-allowed" />
                <span asp-validation-for="IDTipoEmpresa" class="form-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Sigla">Sigla</label>
                <input type="text" class="form-input" asp-for="Sigla"
                       placeholder="Ej. SAC" maxlength="10" />
                <span asp-validation-for="Sigla" class="form-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="TipoEmpresa">Nombre del tipo</label>
            <input type="text" class="form-input" asp-for="TipoEmpresa"
                   placeholder="Ej. Sociedad Anónima Cerrada" />
            <span asp-validation-for="TipoEmpresa" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Descripcion">Descripción</label>
            <textarea class="form-input" asp-for="Descripcion"
                      placeholder="Descripción opcional del tipo de empresa…" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Estado</label>
            <label class="check-label" style="width:fit-content">
                <input type="checkbox" asp-for="Activo" />
                Tipo de empresa activo
            </label>
        </div>

        <div class="form-footer">
            <a class="btn-cancel" asp-action="IndexPaginado">Cancelar</a>
            <button type="submit" class="btn-save">
                <i class="bi bi-check-circle"></i> Crear tipo
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

