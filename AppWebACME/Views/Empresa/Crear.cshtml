@model Models.ACME.EmpresaEntidad

@{
    ViewData["Title"] = "Crear empresa";
}

@* ── Encabezado de módulo ── *@
<div class="mod-header">
    <div>
        <h1 class="mod-title">Empresa</h1>
        <p class="mod-sub">Crear nuevo registro</p>
    </div>
    <a asp-action="IndexPaginado" class="form-back">
        ← Volver al listado
    </a>
</div>

@* ── Formulario ── *@
<div class="form-card">
    <form asp-action="Crear" method="post">

        @* ── Sección: Identificación ── *@
        <div class="form-section">Identificación</div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="IDEmpresa">Código empresa</label>
                <input type="number" min="0" class="form-input" asp-for="IDEmpresa" readonly
                       style="background:#f9fafb;color:#9ca3af;cursor:not-allowed" />
                <span asp-validation-for="IDEmpresa" class="form-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="IDTipoEmpresa">Tipo de empresa</label>
                @Html.DropDownList("IDTipoEmpresa",
                ViewBag.ListaTipoEmpresaEntidad0 as SelectList,
                                "Seleccione un tipo",
                                new { @class = "form-input" })
                <span asp-validation-for="IDTipoEmpresa" class="form-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Empresa">Nombre de empresa</label>
            <input type="text" class="form-input" asp-for="Empresa" placeholder="Ej. Empresa SAC" />
            <span asp-validation-for="Empresa" class="form-error"></span>
        </div>

        @* ── Sección: Datos de contacto ── *@
        <div class="form-section">Datos de contacto</div>

        <div class="form-group">
            <label class="form-label" asp-for="Direccion">Dirección</label>
            <input type="text" class="form-input" asp-for="Direccion" placeholder="Ej. Av. Principal 123, Lima" />
            <span asp-validation-for="Direccion" class="form-error"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="RUC">RUC</label>
                <input type="text" class="form-input" asp-for="RUC"
                       placeholder="20xxxxxxxxx" maxlength="11" />
                <span asp-validation-for="RUC" class="form-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="FechaCreacion">Fecha de creación</label>
                <input type="date" class="form-input" asp-for="FechaCreacion" />
                <span asp-validation-for="FechaCreacion" class="form-error"></span>
            </div>
        </div>

        @* ── Sección: Datos financieros ── *@
        <div class="form-section">Datos financieros</div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="Presupuesto">Presupuesto (S/)</label>
                <input type="number" min="0" step="0.01" class="form-input"
                       asp-for="Presupuesto" placeholder="0.00" />
                <span asp-validation-for="Presupuesto" class="form-error"></span>
            </div>
            <div class="form-group" style="justify-content:flex-end;padding-bottom:.9rem">
                <label class="form-label" asp-for="Activo">Estado</label>
                <label class="check-label" style="width:fit-content">
                    <input type="checkbox" asp-for="Activo" />
                    Empresa activa
                </label>
            </div>
        </div>

        @* ── Footer de acciones ── *@
        <div class="form-footer">
            <a class="btn-cancel" asp-action="IndexPaginado">Cancelar</a>
            <button type="submit" class="btn-save">
                <i class="bi bi-check-circle"></i> Crear empresa
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
