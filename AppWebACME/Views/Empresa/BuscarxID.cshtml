@* @model Models.ACME.EmpresaEntidad

@{
    ViewData["Title"] = "Buscar Empresa";
}

<style>
    .btn img {
        width: 24px;
        height: auto; /* Esto mantiene la proporción de la imagen */
    }
</style>

<div class="card">
    <div class="card-header">
        <div class="d-flex align-items-center justify-content-between">
            <h5 class="col col-md-4">Empresa - Ver detalle</h5>
            <nav class="navbar">
                <div class="container justify-content-end">
                    <div class="btn-group" role="group" aria-label="Barra de herramientas">
                        <!-- Botón: Ir al primer registro -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Inicio" title="Ir al primer registro">
                            <i class="bi bi-skip-backward-fill"></i>
                        </a>

                        <!-- Botón: Ir al registro anterior -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Anterior" title="Ir al registro anterior">
                            <i class="bi bi-caret-left-fill"></i>
                        </a>

                        <!-- Botón: Ir al siguiente registro -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Siguiente" title="Ir al siguiente registro">
                            <i class="bi bi-caret-right-fill"></i>
                        </a>

                        <!-- Botón: Ir al último registro -->
                        <a class="btn btn-primary" asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Fin" title="Ir al último registro">
                            <i class="bi bi-skip-forward-fill"></i>
                        </a>

                        <!-- Botón: Editar -->
                        <a class="btn btn-dark" asp-action="Modificar" asp-route-IDEmpresa="@Model.IDEmpresa" title="Modificar registro">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <!-- Botón: Anular -->
                        <a class="btn btn-danger" asp-action="Anular" asp-route-IDEmpresa="@Model.IDEmpresa" title="Anular registro">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <div class="card-body">
        <div>
            <!-- Campos del formulario -->

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="IDEmpresa" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.IDEmpresa)</label>
                    <input type="number" min="0" class="form-control" asp-for="IDEmpresa" disabled />
                    <span asp-validation-for="IDEmpresa" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IDTipoEmpresa" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.IDTipoEmpresa)</label>
                    @Html.DropDownList("IDTipoEmpresa", ViewBag.ListaTipoEmpresaEntidad0 as SelectList, "Seleccione un tipo", new { @class = "form-select form-select-md mb-3", @disabled = "disabled" })
                    <span asp-validation-for="IDTipoEmpresa" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Empresa" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.Empresa)</label>
                    <input type="text" class="form-control" asp-for="Empresa" disabled />
                    <span asp-validation-for="Empresa" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">

                <div class="col-md-4">
                    <label asp-for="Direccion" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.Direccion)</label>
                    <input type="text" class="form-control" asp-for="Direccion" disabled />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="RUC" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.RUC)</label>
                    <input type="text" class="form-control" asp-for="RUC" disabled />
                    <span asp-validation-for="RUC" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="FechaCreacion" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.FechaCreacion)</label>
                    <input type="date" class="form-control" asp-for="FechaCreacion" disabled />
                    <span asp-validation-for="FechaCreacion" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">

                <div class="col-md-4">
                    <label asp-for="Presupuesto" class="col-sm-4 col-form-label">@Html.DisplayNameFor(model => Model.Presupuesto)</label>
                    <input type="number" min="0" class="form-control" asp-for="Presupuesto" disabled />
                    <span asp-validation-for="Presupuesto" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="col-sm-4 col-form-label" asp-for="Activo">@Html.DisplayNameFor(model => Model.Activo)</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Activo" disabled>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="col-4">
                    <a asp-action="IndexPaginado" class="btn btn-secondary">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>

 *@
@model Models.ACME.EmpresaEntidad

@{
    ViewData["Title"] = "Detalle de empresa";
}

@* ── Encabezado con navegación de registros ── *@
<div class="mod-header">
    <div>
        <h1 class="mod-title">Empresa</h1>
        <p class="mod-sub">Ver detalle · Código @Model.IDEmpresa</p>
    </div>
    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">

        @* ── Navegación entre registros ── *@
        <div style="display:flex;gap:.35rem">
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Inicio"
               title="Primer registro">
                <i class="bi bi-skip-backward-fill" style="font-size:.75rem"></i>
            </a>
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Anterior"
               title="Registro anterior">
                <i class="bi bi-caret-left-fill" style="font-size:.75rem"></i>
            </a>
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Siguiente"
               title="Registro siguiente">
                <i class="bi bi-caret-right-fill" style="font-size:.75rem"></i>
            </a>
            <a class="btn-tbl btn-tbl-view" style="width:32px;height:32px"
               asp-action="BuscarxID" asp-route-IDEmpresa="@ViewBag.Fin"
               title="Último registro">
                <i class="bi bi-skip-forward-fill" style="font-size:.75rem"></i>
            </a>
        </div>

        @* ── Divisor ── *@
        <div style="width:1px;height:28px;background:#e5e7eb"></div>

        @* ── Acciones ── *@
        <a class="btn-tbl btn-tbl-edit" style="width:32px;height:32px"
           asp-action="Modificar" asp-route-IDEmpresa="@Model.IDEmpresa"
           title="Modificar">
            <i class="bi bi-pencil-square"></i>
        </a>
        <a class="btn-tbl btn-tbl-del" style="width:32px;height:32px"
           asp-action="Anular" asp-route-IDEmpresa="@Model.IDEmpresa"
           title="Anular"
           onclick="return confirm('¿Deseas anular la empresa @Model.Empresa?')">
            <i class="bi bi-trash"></i>
        </a>

        @* ── Volver ── *@
        <a asp-action="IndexPaginado" class="form-back" style="margin-bottom:0">
            ← Volver
        </a>
    </div>
</div>

@* ── Card de detalle ── *@
<div class="form-card" style="max-width:720px">

    @* ── Sección: Identificación ── *@
    <div class="form-section">Identificación</div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Código empresa</label>
            <div class="form-input" style="background:#f9fafb;color:#9ca3af;cursor:default">
                @Model.IDEmpresa
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Tipo de empresa</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default">
                @Model.TipoEmpresa
            </div>
        </div>
    </div>

    <div class="form-group">
        <label class="form-label">Nombre de empresa</label>
        <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-weight:600">
            @Model.Empresa
        </div>
    </div>

    @* ── Sección: Datos de contacto ── *@
    <div class="form-section">Datos de contacto</div>

    <div class="form-group">
        <label class="form-label">Dirección</label>
        <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default">
            @Model.Direccion
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">RUC</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-family:monospace">
                @Model.RUC
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Fecha de creación</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default">
                @Model.FechaCreacion.ToString("dd/MM/yyyy")
            </div>
        </div>
    </div>

    @* ── Sección: Datos financieros ── *@
    <div class="form-section">Datos financieros</div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Presupuesto</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-family:monospace;font-weight:600">
                S/ @Model.Presupuesto.ToString("N2")
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Estado</label>
            <div style="padding-top:.4rem">
                @if (Model.Activo)
                {
                    <span class="badge badge-green">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#059669" /></svg>
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge badge-red">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#dc2626" /></svg>
                        Inactivo
                    </span>
                }
            </div>
        </div>
    </div>

</div>
