@model Models.ACME.UnidadMedidaEntidad

@{
    ViewData["Title"] = "Modificar unidad de medida";
}

@* ?? Encabezado de módulo ?? *@
<div class="mod-header">
    <div>
        <h1 class="mod-title">Unidad de medida</h1>
        <p class="mod-sub">Modificar registro · Código @Model.IDUnidadMedida</p>
    </div>
    <a asp-action="IndexPaginado" class="form-back" style="margin-bottom:0">
        ? Volver al listado
    </a>
</div>

@* ?? Formulario ?? *@
<div class="form-card" style="max-width:520px">
    <form asp-action="Modificar" method="post">

        <div class="form-section">Identificación</div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="IDUnidadMedida">Código</label>
                <input type="number" min="0" class="form-input" asp-for="IDUnidadMedida" readonly
                       style="background:#f9fafb;color:#9ca3af;cursor:not-allowed" />
                <span asp-validation-for="IDUnidadMedida" class="form-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Sigla">Sigla</label>
                <input type="text" class="form-input" asp-for="Sigla"
                       placeholder="Ej. KG" maxlength="10" />
                <span asp-validation-for="Sigla" class="form-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="UnidadMedida">Nombre de la unidad</label>
            <input type="text" class="form-input" asp-for="UnidadMedida"
                   placeholder="Ej. Kilogramo" />
            <span asp-validation-for="UnidadMedida" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Estado</label>
            <label class="check-label" style="width:fit-content">
                <input type="checkbox" asp-for="Activo" />
                Unidad de medida activa
            </label>
        </div>

        <div class="form-footer">
            <a class="btn-cancel" asp-action="IndexPaginado">Cancelar</a>
            <button type="submit" class="btn-save">
                <i class="bi bi-check-circle"></i> Guardar cambios
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
