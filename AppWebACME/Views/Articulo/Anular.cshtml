@model Models.ACME.ArticuloEntidad

@{
    ViewData["Title"] = "Anular Articulo";
}

@* ── Encabezado de módulo ── *@
<div class="mod-header">
    <div>
        <h1 class="mod-title">Artículos</h1>
        <p class="mod-sub">Anular registro · Código @Model.IDArticulo</p>
    </div>
    <a asp-action="IndexPaginado" class="form-back" style="margin-bottom:0">
        ← Volver al listado
    </a>
</div>

@* ── Aviso de confirmación ── *@
<div class="toast toast-err" style="max-width:680px;margin-bottom:1.25rem">
    <i class="bi bi-exclamation-triangle-fill" style="font-size:1.1rem;flex-shrink:0"></i>
    <div>
        <strong>¿Está seguro de anular este registro?</strong><br>
        <span style="font-size:.82rem;opacity:.85">
            Esta acción desactivará el artículo <strong>@Model.Articulo</strong>.
            Podrá reactivarlo desde Modificar.
        </span>
    </div>
</div>

@* ── Card de datos (solo lectura) ── *@
<div class="form-card" style="max-width:680px">
    <form asp-action="Anular" method="post">

        @* Campos ocultos — viajan en el POST *@
        <input type="hidden" asp-for="IDArticulo" />

        @* ── Sección: Identificación ── *@
        <div class="form-section">Identificación</div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Código artículo</label>
                <div class="form-input" style="background:#f9fafb;color:#9ca3af;cursor:default">
                    @Model.IDArticulo
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Unidad de medida</label>
                <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default">
                    @Model.UnidadMedida
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Artículo</label>
            <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-weight:600">
                @Model.Articulo
            </div>
        </div>

        @* ── Sección: Datos comerciales ── *@
        <div class="form-section">Datos comerciales</div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Precio</label>
                <div class="form-input" style="background:#f9fafb;color:#374151;cursor:default;font-family:monospace;font-weight:600">
                    @(Model.Precio.HasValue ? $"S/ {Model.Precio.Value:N2}" : "-")
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Stock actual</label>
                <div class="form-input" style="background:#f9fafb;cursor:default;font-family:monospace;font-weight:600;
                     color:@((!Model.StockActual.HasValue || Model.StockActual <= 0) ? "#dc2626" : Model.StockActual <= 5 ? "#d97706" : "#374151")">
                    @(Model.StockActual.HasValue? Model.StockActual.Value.ToString("N0") : "Sin stock")
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Estado actual</label>
            <div style="padding-top:.4rem">
                @if (Model.Activo)
                {
                    <span class="badge badge-green">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#059669" /></svg>
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge badge-red">
                        <svg width="6" height="6" viewBox="0 0 6 6" style="flex-shrink:0"><circle cx="3" cy="3" r="3" fill="#dc2626" /></svg>
                        Inactivo
                    </span>
                }
            </div>
        </div>

        @* ── Footer de acciones ── *@
        <div class="form-footer">
            <a class="btn-cancel" asp-action="IndexPaginado">Cancelar</a>
            <button type="submit" class="btn-save" style="background:#dc2626"
                    onmouseover="this.style.background='#b91c1c'"
                    onmouseout="this.style.background='#dc2626'">
                <i class="bi bi-trash"></i> Confirmar anulación
            </button>
        </div>

    </form>
</div>
